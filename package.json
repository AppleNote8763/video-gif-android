{
  "name": "video-gif-android",
  "private": true,
  "version": "1.3.3",
  "type": "module",
  "scripts": {
    "copy:ffmpeg": "node scripts/copy-ffmpeg-core.mjs",
    "predev": "npm run copy:ffmpeg",
    "dev": "vite",
    "prebuild": "npm run copy:ffmpeg",
    "build": "vite build",
    "android:add": "cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:build": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "preview": "vite preview",
    "preview:host": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.11.0",
    "@ffmpeg/ffmpeg": "^0.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.4",
    "vite": "^5.4.0"
  }
}
